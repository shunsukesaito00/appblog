description: Blog writing must follow playbooks/writing-voice.md (no AI-generic prose)
globs:
  - src/content/blog/**/*
  - src/content/blog-templates/**/*
  - playbooks/revenue-report.md
  - playbooks/writing-voice.md
alwaysApply: false
