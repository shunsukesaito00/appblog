---
import CategoryBadge from "./CategoryBadge.astro";

type Props = {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags: string[];
  href: string;
  readingMinutes?: number;
};

const { title, description, pubDate, category, tags, href, readingMinutes } = Astro.props;
---

<article class="card blog-card">
  <div class="blog-card-topline">
    <p class="date">{pubDate.toLocaleDateString("ja-JP")}</p>
    {
      readingMinutes != null && (
        <p class="reading-time" aria-label={`読了の目安 約${readingMinutes}分`}>
          約{readingMinutes}分
        </p>
      )
    }
  </div>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  <div class="blog-meta">
    <div class="blog-meta-top">
      <CategoryBadge label={category} />
      <a class="text-link" href={href}>続きを読む</a>
    </div>
    <ul>
      {tags.map((tag) => <li>#{tag}</li>)}
    </ul>
  </div>
</article>
