---
/**
 * Google Analytics 4（gtag.js）
 * - 開発（astro dev）では一切出さない
 * - 本番ビルドでは `PUBLIC_GA_ID` を優先。未設定のときは既定 ID（CI に .env が無い Cloudflare Pages 向け）
 */
const defaultGaId = "G-XFJJNW1RCT";
const fromEnv = import.meta.env.PUBLIC_GA_ID?.trim();
const gaId = import.meta.env.PROD ? fromEnv || defaultGaId : "";
const enabled = import.meta.env.PROD && Boolean(gaId);
---

{
  enabled && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag("js", new Date());
        gtag("config", gaId);
      </script>
    </>
  )
}
