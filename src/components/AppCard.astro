---
import type { AppItem } from "../data/apps";

type Props = {
  app: AppItem;
};

const { app } = Astro.props;
const primaryHref = app.introSlug ? `/blog/${app.introSlug}` : app.appStoreUrl;
const primaryIsExternal = !app.introSlug;
const primaryLabel = app.introSlug
  ? `${app.name}の紹介記事を開く`
  : `${app.name}をApp Storeで開く`;
---

<article class="card app-card-store">
  <a
    class="app-card-bglink"
    href={primaryHref}
    aria-label={primaryLabel}
    {...primaryIsExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
  />
  <div class="app-card-store-inner">
    <div class="app-icon-lg">
      <img
        src={app.icon}
        alt=""
        loading="lazy"
        onerror="this.style.display='none';"
      />
    </div>
    <div class="app-card-store-body">
      <p class="app-card-store-cat">{app.category}</p>
      <h3 class="app-card-store-name">{app.name}</h3>
      <p class="app-card-store-desc">{app.description}</p>
    </div>
    {
      app.introSlug ? (
        <a
          class="app-card-store-get"
          href={app.appStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          入手
        </a>
      ) : (
        <span class="app-card-store-badge">App Store</span>
      )
    }
  </div>
</article>
