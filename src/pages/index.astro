---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import AppCard from "../components/AppCard.astro";
import BlogCard from "../components/BlogCard.astro";
import { apps } from "../data/apps";
import { estimateReadingMinutesFromBody } from "../utils/readingTime";
import { getLatestMonthlyRevenueReport } from "../utils/latestRevenueReport";

const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const latestRevenueReport = getLatestMonthlyRevenueReport(allPosts);
const latestRevenueReportLabel = latestRevenueReport
  ? latestRevenueReport.data.pubDate.toLocaleDateString("ja-JP", {
      year: "numeric",
      month: "long",
    })
  : "";
const pnlReport = allPosts.find((post) => post.id === "revenue-report-2026-apr-jul-pnl");
const featuredApps = apps.slice(0, 3);
const recentPosts = allPosts
  .filter(
    (post) =>
      post.id !== latestRevenueReport?.id && post.id !== pnlReport?.id,
  )
  .slice(0, 3);
---

<BaseLayout
  title="個人開発ラボ"
  description="2026年7月のAdMob合計は$0.91。4〜7月の損益は約−4.2万円。会社員エンジニアのiOS個人開発の数字ログです。"
  canonical="/"
>
  <section class="card hero">
    <p class="hero-kicker">個人開発ラボ</p>
    <h1>2026年7月の AdMob は $0.91。4〜7月は約−4.2万円。</h1>
    <p>
      会社員の傍らで iOS アプリを出しています。7月は更新がほぼなく、全アプリ合算の推定収益は
      $0.91 でした。4〜7月をまとめると、AdMob 約921円に対し Cursor Pro+ と Apple
      年会費（按分）だけで約4.3万円。広告では全くペイしていません。
    </p>
    <div class="cta-row">
      {
        latestRevenueReport && (
          <a class="button" href={`/blog/${latestRevenueReport.id}`}>
            {latestRevenueReportLabel}の収益報告
          </a>
        )
      }
      {
        pnlReport && (
          <a class="button subtle" href={`/blog/${pnlReport.id}`}>
            4〜7月の損益
          </a>
        )
      }
      <a class="button subtle" href="/apps">アプリ一覧</a>
    </div>
  </section>

  {
    latestRevenueReport && (
      <section>
        <SectionHeader
          title="最新の数字"
          description="月次の AdMob と、4〜7月の損益"
        />
        <div class="card-grid cols-2">
          <BlogCard
            title={latestRevenueReport.data.title}
            description={latestRevenueReport.data.description}
            pubDate={latestRevenueReport.data.pubDate}
            category={latestRevenueReport.data.category}
            tags={latestRevenueReport.data.tags}
            href={`/blog/${latestRevenueReport.id}`}
            readingMinutes={estimateReadingMinutesFromBody(latestRevenueReport.body)}
          />
          {
            pnlReport && (
              <BlogCard
                title={pnlReport.data.title}
                description={pnlReport.data.description}
                pubDate={pnlReport.data.pubDate}
                category={pnlReport.data.category}
                tags={pnlReport.data.tags}
                href={`/blog/${pnlReport.id}`}
                readingMinutes={estimateReadingMinutesFromBody(pnlReport.body)}
              />
            )
          }
        </div>
      </section>
    )
  }

  <section>
    <SectionHeader title="最近の記事" description="新しい順に3本" />
    <div class="card-grid cols-3">
      {
        recentPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            tags={post.data.tags}
            href={`/blog/${post.id}`}
            readingMinutes={estimateReadingMinutesFromBody(post.body)}
          />
        ))
      }
    </div>
    <div class="cta-row">
      <a class="button subtle" href="/blog">記事一覧</a>
    </div>
  </section>

  <section>
    <SectionHeader title="公開中のアプリ" description="いま出している iOS アプリ" />
    <div class="card-grid cols-3">
      {featuredApps.map((app) => <AppCard app={app} />)}
    </div>
    <div class="cta-row">
      <a class="button subtle" href="/apps">すべて見る</a>
    </div>
  </section>

  <section>
    <SectionHeader title="運営" description="誰が書いているか" />
    <div class="card">
      <p>
        製造業の会社員エンジニアです。本業の合間にアプリを触り、数字は小さくても月次で残しています。
      </p>
      <div class="cta-row">
        <a class="button subtle" href="/about">もう少し詳しく</a>
      </div>
    </div>
  </section>
</BaseLayout>
