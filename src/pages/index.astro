---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import AppCard from "../components/AppCard.astro";
import BlogCard from "../components/BlogCard.astro";
import CategoryBadge from "../components/CategoryBadge.astro";
import FeatureCard from "../components/FeatureCard.astro";
import RoadmapStep from "../components/RoadmapStep.astro";
import { apps } from "../data/apps";
import { estimateReadingMinutesFromBody } from "../utils/readingTime";
import { getLatestMonthlyRevenueReport } from "../utils/latestRevenueReport";

const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const latestRevenueReport = getLatestMonthlyRevenueReport(allPosts);
const latestRevenueReportLabel = latestRevenueReport
  ? latestRevenueReport.data.pubDate.toLocaleDateString("ja-JP", {
      year: "numeric",
      month: "long",
    })
  : "";
const introSlugs = new Set(
  apps.map((a) => a.introSlug).filter((slug): slug is string => Boolean(slug)),
);
const appIntroPosts = allPosts
  .filter((post) => introSlugs.has(post.id))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featuredApps = apps.slice(0, 3);
const usefulGuideIds = new Set([
  "salary-pdf-import-takehome-howto",
  "salary-gross-takehome-gap-howto",
  "indie-ios-app-not-growing-analysis",
]);
const isRevenueReport = (id: string) => id.startsWith("revenue-report");
const usefulGuides = allPosts.filter((post) => usefulGuideIds.has(post.id));
const popularPosts = [
  ...usefulGuides,
  ...allPosts.filter(
    (post) => !usefulGuideIds.has(post.id) && !isRevenueReport(post.id),
  ),
].slice(0, 3);
const categories = [...new Set(allPosts.map((post) => post.data.category))].sort(
  (a, b) => a.localeCompare(b, "ja"),
);

const featureAreas = [
  {
    title: "実務ガイド・How-to",
    description: "給与明細のPDF取り込みや手取り記録など、検索意図に応える実務記事をまとめています。",
    href: "/blog/salary-pdf-import-takehome-howto",
    linkLabel: "PDF取り込みガイドを読む",
  },
  {
    title: "個人開発の分析",
    description: "DLと収益のズレなど、公開数字に基づく伸び悩みの整理を掲載しています。",
    href: "/blog/indie-ios-app-not-growing-analysis",
    linkLabel: "分析記事を読む",
  },
  {
    title: "副業収益の検証ログ",
    description: "小さなAdMob数字も飾らず、月次で残しています（誇大な約束はしません）。",
    href: latestRevenueReport ? `/blog/${latestRevenueReport.id}` : "/blog",
    linkLabel: latestRevenueReport ? "最新の収益ログを見る" : "記事一覧を見る",
  },
];
---

<BaseLayout
  title="個人開発ラボ | 個人開発・副業収益化・iOSアプリ改善の実践ブログ"
  description="個人開発で副業収益化を目指す会社員エンジニアが、iOSアプリ開発、ASO、App Store改善、Cursor/Codex活用を実践記録するブログです。"
  canonical="/"
>
  <section class="card hero">
    <p class="eyebrow">実務ガイド × 正直な検証ログ</p>
    <p class="hero-kicker">小さな数字から続く、個人開発の実務と記録</p>
    <h1>会社員エンジニアが iOS で試す、実践ポートフォリオ。</h1>
    <p>
      給与明細などの実務ガイドと、公開数字に基づく分析・検証ログをまとめています。まだ月数ドル規模の収益でも、数字は飾らず記録します。
    </p>
    <div class="cta-row">
      <a class="button" href="/blog/salary-pdf-import-takehome-howto">実務ガイドを読む</a>
      <a class="button subtle" href="/apps">アプリを見る</a>
      {
        latestRevenueReport && (
          <a class="button subtle" href={`/blog/${latestRevenueReport.id}`}>
            最新収益ログ（{latestRevenueReportLabel}）
          </a>
        )
      }
    </div>
  </section>

  <section>
    <SectionHeader
      title="実務ガイド・分析"
      description="検索意図に応えるHow-toと、公開数字に基づく伸び悩みの整理"
    />
    <div class="card-grid cols-3">
      {
        usefulGuides.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            tags={post.data.tags}
            href={`/blog/${post.id}`}
            readingMinutes={estimateReadingMinutesFromBody(post.body)}
          />
        ))
      }
    </div>
  </section>

  <section>
    <SectionHeader title="このサイトで読めること" description="ガイドを先に、検証ログは正直に" />
    <div class="card-grid cols-3">
      {
        featureAreas.map((area) => (
          <FeatureCard
            title={area.title}
            description={area.description}
            href={area.href}
            linkLabel={area.linkLabel}
          />
        ))
      }
    </div>
  </section>

  <section>
    <SectionHeader
      title="おすすめ記事"
      description="How-to・分析を優先して掲載しています。"
    />
    <div class="card-grid cols-3">
      {
        popularPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            tags={post.data.tags}
            href={`/blog/${post.id}`}
            readingMinutes={estimateReadingMinutesFromBody(post.body)}
          />
        ))
      }
    </div>
  </section>

  {
    latestRevenueReport && (
      <section>
        <SectionHeader
          title="最新の収益ログ"
          description="月次のAdMobとDLの検証メモ（誇大な約束はしません）"
        />
        <div class="card-grid cols-2">
          <BlogCard
            title={latestRevenueReport.data.title}
            description={latestRevenueReport.data.description}
            pubDate={latestRevenueReport.data.pubDate}
            category={latestRevenueReport.data.category}
            tags={latestRevenueReport.data.tags}
            href={`/blog/${latestRevenueReport.id}`}
            readingMinutes={estimateReadingMinutesFromBody(latestRevenueReport.body)}
          />
        </div>
      </section>
    )
  }

  <section>
    <SectionHeader title="収益化ロードマップ" description="作る、出す、改善する、収益化する" />
    <div class="card-grid cols-4">
      <RoadmapStep
        step="Step 1"
        title="課題を選んで作る"
        description="検索される課題を狙って、最小機能のiOSアプリを素早く公開します。"
      />
      <RoadmapStep
        step="Step 2"
        title="App Storeに出す"
        description="タイトル、説明文、スクリーンショットを整えて初速を作ります。"
      />
      <RoadmapStep
        step="Step 3"
        title="ASOで改善する"
        description="流入とCVRを追いながら、訴求と導線を継続的に改善します。"
      />
      <RoadmapStep
        step="Step 4"
        title="収益化を積み上げる"
        description="広告や有料機能を検証し、継続率と収益性を高めます。"
      />
    </div>
  </section>

  <section>
    <SectionHeader title="Featured Apps" description="公開中の個人開発アプリ" />
    <div class="card-grid cols-3">
      {featuredApps.map((app) => <AppCard app={app} />)}
    </div>
  </section>

  <section>
    <SectionHeader
      title="アプリ紹介記事"
      description="機能・実績・App Store への導線をまとめた紹介記事です"
    />
    <div class="card-grid cols-2">
      {appIntroPosts.map((post) => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          category={post.data.category}
          tags={post.data.tags}
          href={`/blog/${post.id}`}
          readingMinutes={estimateReadingMinutesFromBody(post.body)}
        />
      ))}
    </div>
    <div class="cta-row">
      <a class="button subtle" href="/apps">アプリ一覧と紹介リンク</a>
      <a class="button subtle" href="/blog">ブログ一覧へ</a>
    </div>
  </section>

  <section>
    <SectionHeader title="Categories" description="テーマから記事を探す" />
    <div class="card">
      <div class="category-scroll-row" aria-label="カテゴリ一覧">
        {categories.map((category) => (
          <CategoryBadge label={category} />
        ))}
      </div>
      <div class="cta-row">
        <a class="button subtle" href="/blog">記事一覧へ</a>
        <a class="button subtle" href="/categories">カテゴリ一覧へ</a>
      </div>
    </div>
  </section>

  <section>
    <SectionHeader title="About Summary" description="運営者と発信方針" />
    <div class="card">
      <p>
        こんにちは。本業の合間にアプリを触って、ときどき徹夜して、翌朝は後悔しつつもまた改善したくなる——そんなサイクルを回している会社員エンジニアです。
      </p>
      <p>
        個人開発ラボでは、その泥臭い試行錯誤（ASO、収益化、Cursor/Codex など）をできるだけ正直に残しています。同じ立場の方の参考になればうれしいです。
      </p>
      <div class="cta-row">
        <a class="button subtle" href="/apps">アプリ一覧を見る</a>
        <a class="button subtle" href="/blog">最新記事を読む</a>
        <a class="button subtle" href="/about">運営者について</a>
      </div>
    </div>
  </section>
</BaseLayout>
