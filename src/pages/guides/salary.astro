---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { apps } from "../../data/apps";

const salaryApp = apps.find((app) => app.name === "給与明細管理");
const guides = [
  {
    href: "/blog/salary-pdf-import-takehome-howto",
    title: "給与明細 PDF 取り込みと手取り記録のやり方",
  },
  {
    href: "/blog/salary-gross-takehome-gap-howto",
    title: "手取りと総支給の差を毎月記録する理由とやり方",
  },
  {
    href: "/blog/salary-social-insurance-howto",
    title: "社会保険料（健康保険・厚生年金）の見方と記録",
  },
  {
    href: "/blog/salary-bonus-record-howto",
    title: "賞与を給与明細アプリにどう残すか",
  },
];
---

<BaseLayout
  title="給与明細ガイド｜PDF・手取り・社会保険・賞与 | 個人開発ラボ"
  description="給与明細のPDF取り込み、手取りと総支給の差、社会保険料、賞与の残し方。記事と給与明細管理アプリへの入口です。"
  canonical="/guides/salary"
>
  <article class="card article-shell">
    <header class="article-header">
      <h1>給与明細ガイド</h1>
      <p class="article-lead">
        PDFの取り込み、手取りと総支給の差、社会保険料、賞与月の残し方——いま公開している記事はこの4本です。税務の代行や計算の保証はしません。
      </p>
    </header>

    <SectionHeader title="記事一覧" description="目的から選ぶ" />
    <nav class="card app-intro-nav" aria-label="給与明細の実務ガイド">
      <ul>
        {
          guides.map((g) => (
            <li>
              <a href={g.href}>{g.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <SectionHeader
      title="アプリ"
      description="給与明細管理の紹介と App Store"
    />
    <nav class="card app-intro-nav" aria-label="給与明細管理アプリ紹介">
      <ul>
        <li>
          <a href="/blog/app-intro-salary">「給与明細管理」アプリ紹介</a>
        </li>
      </ul>
      <div class="cta-row">
        {
          salaryApp && (
            <a
              class="button"
              href={salaryApp.appStoreUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              App Storeで確認する
            </a>
          )
        }
        <a class="button subtle" href="/blog">ブログ一覧</a>
        <a class="button subtle" href="/apps">アプリ一覧</a>
      </div>
    </nav>
  </article>
</BaseLayout>
