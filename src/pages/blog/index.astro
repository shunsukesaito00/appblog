---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import BlogCard from "../../components/BlogCard.astro";
import { estimateReadingMinutesFromBody } from "../../utils/readingTime";
import { getLatestMonthlyRevenueReport } from "../../utils/latestRevenueReport";

const APP_INTRO_TAG = "アプリ紹介";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const latestRevenueReport = getLatestMonthlyRevenueReport(posts);
const latestRevenueReportLabel = latestRevenueReport
  ? latestRevenueReport.data.pubDate.toLocaleDateString("ja-JP", {
      year: "numeric",
      month: "long",
    })
  : "";
const introPosts = posts.filter((p) => p.data.tags.includes(APP_INTRO_TAG));
const otherPosts = posts.filter((p) => !p.data.tags.includes(APP_INTRO_TAG));
const showSplit = otherPosts.length > 0;
---

<BaseLayout
  title="ブログ一覧 | 個人開発ラボ"
  description="自作iOSアプリの紹介記事と、個人開発・副業収益化・App Store改善のログです。"
  canonical="/blog"
  ogType="article"
>
  <div class="page-blog">
    <header class="blog-list-intro card">
      <p class="blog-list-eyebrow">Journal</p>
      <h1 class="blog-list-title">ブログ</h1>
      <p class="blog-list-lead">
        アプリ紹介の記事を先頭に、そのほかの記事を新しい順で掲載しています。
      </p>
      {
        latestRevenueReport && (
          <div class="cta-row blog-list-spotlight-cta">
            <a class="button" href={`/blog/${latestRevenueReport.id}`}>
              最新の収益報告（{latestRevenueReportLabel}）を読む
            </a>
          </div>
        )
      }
    </header>

    {
      latestRevenueReport && (
        <section class="blog-revenue-spotlight">
          <SectionHeader
            title="最新の収益報告"
            description="月次のAdMob収益とApp Store ConnectのDLログ"
          />
          <div class="card-grid cols-2 blog-list-grid">
            <BlogCard
              title={latestRevenueReport.data.title}
              description={latestRevenueReport.data.description}
              pubDate={latestRevenueReport.data.pubDate}
              category={latestRevenueReport.data.category}
              tags={latestRevenueReport.data.tags}
              href={`/blog/${latestRevenueReport.id}`}
              readingMinutes={estimateReadingMinutesFromBody(latestRevenueReport.body)}
            />
          </div>
        </section>
      )
    }

    {
      showSplit ? (
        <>
          <SectionHeader title="アプリ紹介記事" description="機能・実績・ストア導線" />
          <div class="card-grid cols-2 blog-list-grid">
            {introPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category}
                tags={post.data.tags}
                href={`/blog/${post.id}`}
                readingMinutes={estimateReadingMinutesFromBody(post.body)}
              />
            ))}
          </div>

          <SectionHeader title="その他の記事" description="新しい順" />
          <div class="card-grid cols-2 blog-list-grid">
            {otherPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category}
                tags={post.data.tags}
                href={`/blog/${post.id}`}
                readingMinutes={estimateReadingMinutesFromBody(post.body)}
              />
            ))}
          </div>
        </>
      ) : (
        <>
          <SectionHeader title="アプリ紹介記事" description="新しい順" />
          <div class="card-grid cols-2 blog-list-grid">
            {introPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category}
                tags={post.data.tags}
                href={`/blog/${post.id}`}
                readingMinutes={estimateReadingMinutesFromBody(post.body)}
              />
            ))}
          </div>
        </>
      )
    }

    <div class="cta-row blog-list-footer-cta">
      <a class="button subtle" href="/apps">アプリ一覧へ</a>
    </div>
  </div>
</BaseLayout>
