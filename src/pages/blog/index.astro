---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import BlogCard from "../../components/BlogCard.astro";
import { estimateReadingMinutesFromBody } from "../../utils/readingTime";
import { getLatestMonthlyRevenueReport } from "../../utils/latestRevenueReport";

const APP_INTRO_TAG = "アプリ紹介";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const latestRevenueReport = getLatestMonthlyRevenueReport(posts);
const latestRevenueReportLabel = latestRevenueReport
  ? latestRevenueReport.data.pubDate.toLocaleDateString("ja-JP", {
      year: "numeric",
      month: "long",
    })
  : "";
const pnlReport = posts.find((p) => p.id === "revenue-report-2026-apr-jul-pnl");
const introPosts = posts.filter((p) => p.data.tags.includes(APP_INTRO_TAG));
const otherPosts = posts.filter((p) => !p.data.tags.includes(APP_INTRO_TAG));
const showSplit = otherPosts.length > 0;
---

<BaseLayout
  title="ブログ一覧 | 個人開発ラボ"
  description="2026年7月のAdMobは$0.91。4〜7月の損益は約−4.2万円。アプリ紹介と月次ログを新しい順に並べています。"
  canonical="/blog"
  ogType="article"
>
  <div class="page-blog">
    <header class="blog-list-intro card">
      <h1 class="blog-list-title">ブログ</h1>
      <p class="blog-list-lead">
        2026年7月の AdMob 合計は $0.91。4〜7月は収益約921円に対し、Cursor と Apple
        年会費（按分）で約4.3万円の赤字でした。下はアプリ紹介と、そのほかの記事です。
      </p>
      {
        latestRevenueReport && (
          <div class="cta-row blog-list-spotlight-cta">
            <a class="button" href={`/blog/${latestRevenueReport.id}`}>
              {latestRevenueReportLabel}の収益報告
            </a>
            {
              pnlReport && (
                <a class="button subtle" href={`/blog/${pnlReport.id}`}>
                  4〜7月の損益
                </a>
              )
            }
          </div>
        )
      }
    </header>

    {
      latestRevenueReport && (
        <section class="blog-revenue-spotlight">
          <SectionHeader
            title="最新の数字"
            description={`${latestRevenueReportLabel}の月次と、4〜7月の損益`}
          />
          <div class="card-grid cols-2 blog-list-grid">
            <BlogCard
              title={latestRevenueReport.data.title}
              description={latestRevenueReport.data.description}
              pubDate={latestRevenueReport.data.pubDate}
              category={latestRevenueReport.data.category}
              tags={latestRevenueReport.data.tags}
              href={`/blog/${latestRevenueReport.id}`}
              readingMinutes={estimateReadingMinutesFromBody(latestRevenueReport.body)}
            />
            {
              pnlReport && (
                <BlogCard
                  title={pnlReport.data.title}
                  description={pnlReport.data.description}
                  pubDate={pnlReport.data.pubDate}
                  category={pnlReport.data.category}
                  tags={pnlReport.data.tags}
                  href={`/blog/${pnlReport.id}`}
                  readingMinutes={estimateReadingMinutesFromBody(pnlReport.body)}
                />
              )
            }
          </div>
        </section>
      )
    }

    {
      showSplit ? (
        <>
          <SectionHeader
            title="アプリ紹介"
            description={`公開中のアプリ ${introPosts.length} 本`}
          />
          <div class="card-grid cols-2 blog-list-grid">
            {introPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category}
                tags={post.data.tags}
                href={`/blog/${post.id}`}
                readingMinutes={estimateReadingMinutesFromBody(post.body)}
              />
            ))}
          </div>

          <SectionHeader title="そのほか" description="新しい順" />
          <div class="card-grid cols-2 blog-list-grid">
            {otherPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category}
                tags={post.data.tags}
                href={`/blog/${post.id}`}
                readingMinutes={estimateReadingMinutesFromBody(post.body)}
              />
            ))}
          </div>
        </>
      ) : (
        <>
          <SectionHeader
            title="アプリ紹介"
            description={`公開中のアプリ ${introPosts.length} 本`}
          />
          <div class="card-grid cols-2 blog-list-grid">
            {introPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category}
                tags={post.data.tags}
                href={`/blog/${post.id}`}
                readingMinutes={estimateReadingMinutesFromBody(post.body)}
              />
            ))}
          </div>
        </>
      )
    }

    <div class="cta-row blog-list-footer-cta">
      <a class="button subtle" href="/apps">アプリ一覧</a>
    </div>
  </div>
</BaseLayout>
