---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryBadge from "../../components/CategoryBadge.astro";
import RelatedAppCta from "../../components/RelatedAppCta.astro";
import BlogCard from "../../components/BlogCard.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import AdSenseUnit from "../../components/AdSenseUnit.astro";
import { apps } from "../../data/apps";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const relatedApp = apps.find((app) => app.name === post.data.relatedApp);
const latestPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .filter((entry) => entry.id !== post.id)
  .slice(0, 2);

const siteOrigin =
  Astro.site?.origin ?? "https://kojin-dev-lab.pages.dev";
const articleUrl = new URL(`/blog/${post.id}`, siteOrigin).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  mainEntityOfPage: articleUrl,
  url: articleUrl,
  author: {
    "@type": "Person",
    name: "個人開発ラボ",
  },
  publisher: {
    "@type": "Organization",
    name: "個人開発ラボ",
  },
};
---

<BaseLayout
  title={`${post.data.title} | 個人開発ラボ`}
  description={post.data.description}
  canonical={`/blog/${post.id}`}
  ogTitle={post.data.title}
  ogDescription={post.data.description}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="page-article">
    <article class="card article-shell">
      <header class="article-header">
        <p class="article-eyebrow">{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p class="article-lead">{post.data.description}</p>
        <div class="article-meta-row">
          <time class="article-date" datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString("ja-JP")}
          </time>
          <div class="article-tags">
            {post.data.tags.map((tag) => (
              <CategoryBadge label={`#${tag}`} />
            ))}
          </div>
        </div>
      </header>
      <div class="article-content prose">
        <Content />
      </div>

      <AdSenseUnit />
    </article>

    <section class="article-related-app">
      <RelatedAppCta app={relatedApp} />
    </section>

    <section class="article-more">
      <SectionHeader title="最新記事" description="ほかに読める記事" />
      <div class="card-grid cols-2">
        {latestPosts.map((entry) => (
          <BlogCard
            title={entry.data.title}
            description={entry.data.description}
            pubDate={entry.data.pubDate}
            category={entry.data.category}
            tags={entry.data.tags}
            href={`/blog/${entry.id}`}
          />
        ))}
      </div>
      <div class="cta-row article-follow-cta">
        <a class="button subtle" href="/categories">カテゴリ一覧を見る</a>
        <a class="button subtle" href="/blog">記事一覧へ戻る</a>
      </div>
    </section>
  </div>
</BaseLayout>
