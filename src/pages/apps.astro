---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import AppCard from "../components/AppCard.astro";
import { apps } from "../data/apps";

const appsWithIntro = apps.filter((app) => app.introSlug);
---

<BaseLayout
  title="アプリ一覧 | 個人開発ラボ"
  description="公開中の自作iOSアプリ一覧。紹介記事と App Store へのリンクがあります。"
  canonical="/apps"
>
  <SectionHeader
    title="アプリ"
    description={`いま公開中の ${apps.length} 本`}
  />
  <div class="card-grid cols-2">
    {apps.map((app) => <AppCard app={app} />)}
  </div>

  <section>
    <SectionHeader
      title="紹介記事"
      description={`ブログ内の紹介 ${appsWithIntro.length} 本`}
    />
    <nav class="card app-intro-nav" aria-label="アプリ紹介記事へのリンク">
      <ul>
        {
          appsWithIntro.map((app) => (
            <li>
              <a href={`/blog/${app.introSlug}`}>{app.name}の紹介と実績</a>
            </li>
          ))
        }
      </ul>
      <div class="cta-row">
        <a class="button subtle" href="/blog">ブログ一覧へ</a>
      </div>
    </nav>
  </section>
</BaseLayout>
