---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";

const categoryList = [
  "個人開発",
  "ASO",
  "App Store",
  "Cursor",
  "Codex",
  "AdMob",
  "副業収益化",
  "iOSアプリ開発",
];

const posts = await getCollection("blog");
const grouped = categoryList.map((category) => ({
  category,
  items: posts.filter((post) => post.data.category === category),
}));
---

<BaseLayout
  title="カテゴリ一覧 | 個人開発ラボ"
  description="個人開発ラボの記事カテゴリ一覧です。"
  canonical="/categories"
>
  <SectionHeader title="Categories" description="カテゴリから記事を探す" />
  <div class="card-grid cols-2">
    {grouped.map((group) => (
      <section class="card">
        <h3>{group.category}</h3>
        {
          group.items.length > 0 ? (
            <ul>
              {group.items.map((item) => (
                <li><a href={`/blog/${item.id}`}>{item.data.title}</a></li>
              ))}
            </ul>
          ) : (
            <p>このカテゴリの記事は準備中です。</p>
          )
        }
      </section>
    ))}
  </div>
</BaseLayout>
