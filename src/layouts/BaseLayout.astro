---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import GoogleAdSense from "../components/GoogleAdSense.astro";
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  twitterCard?: string;
};

const {
  title,
  description,
  canonical,
  ogTitle = title,
  ogDescription = description,
  ogType = "website",
  ogImage = "/ogp.png",
  ogImageAlt,
  twitterCard = "summary_large_image",
} = Astro.props;

const siteName = "個人開発ラボ";
const siteSubtitle = "会社員エンジニアによる副業アプリ開発・ASO・収益化の実践ログ";
const baseUrl = Astro.site ?? new URL("https://appblog-a4k.pages.dev");
const normalizedCanonical =
  canonical === undefined
    ? undefined
    : canonical === "/"
      ? "/"
      : canonical.endsWith("/")
        ? canonical
        : `${canonical}/`;
const canonicalUrl = normalizedCanonical
  ? new URL(normalizedCanonical, baseUrl).toString()
  : Astro.url.toString();
const ogUrl = canonicalUrl;
const ogImageUrl =
  ogImage.startsWith("https://") || ogImage.startsWith("http://")
    ? ogImage
    : new URL(ogImage, baseUrl).toString();
const resolvedOgImageAlt = ogImageAlt ?? ogTitle;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <GoogleAnalytics />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:card" content={twitterCard} />

    <meta name="theme-color" content="#0B0D10" />

    <GoogleAdSense />
  </head>
  <body>
    <Header siteName={siteName} siteSubtitle={siteSubtitle} />
    <main class="container">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        var h = document.querySelector(".site-header");
        if (!h) return;
        function onScroll() {
          h.classList.toggle("header--compact", window.scrollY > 12);
        }
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      })();
    </script>
  </body>
</html>
